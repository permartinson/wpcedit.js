{
  "name": "wpcedit",
  "version": "0.4.4",
  "description": "WPCEdit.js is a javascript library based on the WPC Edit app, used for viewing and editing contents of WPC pinball rom files",
  "author": "Per Martinson, original code by Garrett Lee",
  "license": "ISC",
  "type": "module",
  "main": "dist/WPCEdit.js",
  "types": "dist/WPCEdit.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:update": "vitest run --update"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/permartinson/wpcedit.js.git"
  },
  "bugs": {
    "url": "https://github.com/permartinson/wpcedit.js/issues"
  },
  "homepage": "https://github.com/permartinson/wpcedit.js#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.13.0",
    "eslint": "^9.39.5",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7"
  }
}
